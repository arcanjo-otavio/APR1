def ler_arquivo(nome_arquivo):
    linhas_do_arquivo = []
    try:
        arquivo = open(nome_arquivo, "r")
    except FileNotFoundError:
        return linhas_do_arquivo
    for linha in arquivo:
        linha = tirar_espacos(linha)
        if linha != "":
            linhas_do_arquivo.append(separar_texto(linha, "|"))
    arquivo.close()
    return linhas_do_arquivo


