def relatorio_c(faxineiros, clientes, servicos):
    print("")
    print("Relatorio C: servicos de um faxineiro")
    cpf_faxineiro = ler_cpf("CPF do faxineiro: ")
    if cpf_faxineiro not in faxineiros:
        print("Faxineiro nao encontrado.")
    else:
        linhas = []
        linhas.append("RELATORIO C - Servicos do faxineiro " + faxineiros[cpf_faxineiro][1])
        linhas.append("CPF do faxineiro: " + cpf_faxineiro)
        linhas.append("------------------------------------------------------------")
        quantidade = 0
        total = 0.0
        for chave in servicos:
            servico = servicos[chave]
            if servico[0] == cpf_faxineiro:
                nome_cliente = "(nao encontrado)"
                if servico[1] in clientes:
                    nome_cliente = clientes[servico[1]][0]
                linhas.append("Data: " + servico[2] + "   Valor: R$ " + servico[3])
                linhas.append("  Faxineiro: " + faxineiros[cpf_faxineiro][1] + " (CPF " + servico[0] + ")")
                linhas.append("  Cliente: " + nome_cliente + " (CPF " + servico[1] + ")")
                linhas.append("")
                quantidade += 1
                total += float(servico[3])
        if quantidade == 0:
            linhas.append("Esse faxineiro ainda nao fez nenhum servico.")
        else:
            linhas.append("Quantidade de servicos: " + str(quantidade))
            linhas.append("Valor total: R$ " + str(round(total, 2)))
        gravar_relatorio("relatorio_c.txt", linhas)

