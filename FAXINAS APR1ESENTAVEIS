def relatorio_b(faxineiros, clientes, servicos):
    print("")
    print("Relatorio B: servicos de uma data")
    data = ler_data("Data (dd/mm/aaaa): ")
    linhas = []
    linhas.append("RELATORIO B - Servicos do dia " + data)
    linhas.append("------------------------------------------------------------")
