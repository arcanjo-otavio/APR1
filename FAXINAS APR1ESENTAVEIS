######### SEPARAÇÂO DE TEXTO ######################
def separar_texto(texto, separador):
    lista = []
    pedaco = ""
    for letra in texto:
        if letra == separador:
            lista.append(pedaco)
            pedaco = ""
        else:
            pedaco += letra
    lista.append(pedaco)
    return lista


######### tira espaco e enter do comeco e do fim ######################
def tirar_espacos(texto):
    comeco = 0
    fim = len(texto) - 1
    while comeco <= fim and (texto[comeco] == " " or texto[comeco] == "\n" or texto[comeco] == "\r" or texto[comeco] == "\t"):
        comeco += 1
    while fim >= comeco and (texto[fim] == " " or texto[fim] == "\n" or texto[fim] == "\r" or texto[fim] == "\t"):
        fim -= 1
    novo = ""
    for i in range(comeco, fim + 1):
        novo += texto[i]
    return novo

def somente_digitos(texto):
    if len(texto) == 0:
        return False
    for letra in texto:
        if letra < "0" or letra > "9":
            return False
    return True


######### DATA ######################

def dias_no_mes(mes, ano):
    if mes == 2:
        if ano_bissexto(ano) == True:
            return 29
        return 28
    if mes == 4 or mes == 6 or mes == 9 or mes == 11:
        return 30
    return 31


def data_valida(texto):
    partes = separar_texto(texto, "/")
    if len(partes) != 3:
        return False
    if len(partes[0]) != 2 or len(partes[1]) != 2 or len(partes[2]) != 4:
        return False
    if somente_digitos(partes[0]) == False or somente_digitos(partes[1]) == False or somente_digitos(partes[2]) == False:
        return False
    dia = int(partes[0])
    mes = int(partes[1])
    ano = int(partes[2])
    if mes < 1 or mes > 12:
        return False
    if dia < 1 or dia > dias_no_mes(mes, ano):
        return False
    return True


######### troca pra "aaaammdd" pra conseguir comparar data ######################
def data_para_numero(texto):
    partes = separar_texto(texto, "/")
    return int(partes[2]) * 10000 + int(partes[1]) * 100 + int(partes[0])


#### TIVE QUE FAZER UMA FUNÇÂO PRA ANO BISSEXTO KKKKK #################
def ano_bissexto(ano):
    if ano % 400 == 0:
        return True
    if ano % 100 == 0:
        return False
    if ano % 4 == 0:
        return True
    return False

######### ENTRADA ######################
def ler_texto(mensagem):
    texto = ""
    while texto == "":
        texto = tirar_espacos(input(mensagem))
        if texto == "":
            print("Nao pode ficar vazio!")
######### troca o | por / porque usei pra separar no arquivo ######################
    novo = ""
    for letra in texto:
        if letra == "|":
            novo += "/"
        else:
            novo += letra
    return novo


def ler_cpf(mensagem):
    cpf = ""
    while len(cpf) != 11 or somente_digitos(cpf) == False:
        cpf = tirar_espacos(input(mensagem))
        if len(cpf) != 11 or somente_digitos(cpf) == False:
            print("CPF invalido! Digite 11 numeros, sem pontos nem traco.")
    return cpf


def ler_cep(mensagem):
    cep = ""
    while len(cep) != 8 or somente_digitos(cep) == False:
        cep = tirar_espacos(input(mensagem))
        if len(cep) != 8 or somente_digitos(cep) == False:
            print("CEP invalido! Digite 8 numeros, sem traco.")
    return cep


def ler_data(mensagem):
    data = ""
    while data_valida(data) == False:
        data = tirar_espacos(input(mensagem))
        if data_valida(data) == False:
            print("Data invalida! Use o formato dd/mm/aaaa.")
    return data


def ler_sexo(mensagem):
    sexo = ""
    while sexo != "M" and sexo != "F":
        sexo = tirar_espacos(input(mensagem))
        if sexo == "m":
            sexo = "M"
        if sexo == "f":
            sexo = "F"
        if sexo != "M" and sexo != "F":
            print("Digite M ou F!")
    return sexo


def ler_valor(mensagem):
    valido = False
    while valido == False:
        texto = tirar_espacos(input(mensagem))
######### troca virgula por ponto ######################
        valor = ""
        for letra in texto:
            if letra == ",":
                valor += "."
            else:
                valor += letra
        try:
            numero = float(valor)
            if numero >= 0:
                valido = True
            else:
                print("O valor nao pode ser negativo!")
        except ValueError:
            print("Valor invalido! Digite so numeros, exemplo 150.50")
    return valor


def confirmar(mensagem):
    resposta = ""
    while resposta != "S" and resposta != "N":
        resposta = tirar_espacos(input(mensagem))
        if resposta == "s":
            resposta = "S"
        if resposta == "n":
            resposta = "N"
        if resposta != "S" and resposta != "N":
            print("Digite S ou N!")
    if resposta == "S":
        return True
    else:
        return False


