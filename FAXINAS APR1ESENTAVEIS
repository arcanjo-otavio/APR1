        data_inicial = ler_data("Data inicial (dd/mm/aaaa): ")
        data_final = ler_data("Data final (dd/mm/aaaa): ")
        if data_para_numero(data_inicial) > data_para_numero(data_final):
            print("A data inicial nao pode ser maior que a data final!")
        else:
            linhas = []
            linhas.append("RELATORIO A - Clientes atendidos pelo faxineiro " + faxineiros[cpf_faxineiro][1])
            linhas.append("CPF do faxineiro: " + cpf_faxineiro)
            linhas.append("Periodo: " + data_inicial + " ate " + data_final)
            linhas.append("------------------------------------------------------------")
            cpfs_ja_mostrados = []
            for chave in servicos:
                servico = servicos[chave]
                if servico[0] == cpf_faxineiro:
                    numero_data = data_para_numero(servico[2])
                    if numero_data >= data_para_numero(data_inicial) and numero_data <= data_para_numero(data_final):
                        cpf_cliente = servico[1]
                        ######### so mostra o cliente uma vez mesmo se ele contratou varias vezes ######################
                        if cpf_cliente not in cpfs_ja_mostrados:
                            cpfs_ja_mostrados.append(cpf_cliente)
                            if cpf_cliente in clientes:
                                linhas.append("Nome: " + clientes[cpf_cliente][0])
                                linhas.append("  E-mails: " + clientes[cpf_cliente][5])
                                linhas.append("  Telefones: " + clientes[cpf_cliente][6])
                            else:
                                linhas.append("Cliente CPF " + cpf_cliente + " (nao encontrado)")
                            linhas.append("")
            if len(cpfs_ja_mostrados) == 0:
                linhas.append("Nenhum cliente atendido nesse periodo.")
            gravar_relatorio("relatorio_a.txt", linhas)


